# Deploy yacewo-worker, then set this to the printed Worker URL (no trailing slash).
VITE_YACEWO_ROOMS_URL=https://yacewo-rooms.YOUR_SUBDOMAIN.workers.dev

# Public half of the VAPID keypair (generate with: npx @pushforge/builder vapid).
# Private key goes in the Worker as secret VAPID_PRIVATE_KEY — never commit it.
VITE_VAPID_PUBLIC_KEY=
